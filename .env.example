# Локальное окружение Shosai — только значения для этой машины.
# Production- и staging-значений здесь нет и быть не может: они живут в
# секретах окружения, а не в git (CLAUDE.md, «Security»).
#
# Использование: `cp .env.example .env` в корне репозитория. Compose читает
# корневой .env сам; бэкенд берёт настройки из раздела 2, его тесты — только
# из раздела 3.
# Внимание: backend/.env содержит production-значения чистовика — не путать.
# Подробности — docs/development.md.

# ---------------------------------------------------------------------------
# 1. Параметры compose.dev.yaml. Все необязательны: без .env действуют
#    значения по умолчанию, записанные ниже. Порты слушают только 127.0.0.1.
#    Пароли применяются к базам при первом запуске; после смены нужен сброс
#    (`scripts/local-env.sh reset`).
# ---------------------------------------------------------------------------

# Порты на 127.0.0.1: прямой доступ к серверам домов (миграции, администратор).
LOCAL_POSTGRES_RU_PORT=15432
LOCAL_POSTGRES_EU_PORT=15433
# Порты PgBouncer домов (приложение и тесты под ролью приложения).
LOCAL_PGBOUNCER_RU_PORT=16432
LOCAL_PGBOUNCER_EU_PORT=16433
LOCAL_VALKEY_PORT=16379
LOCAL_REDIS_CACHE_PORT=16380
LOCAL_QDRANT_HTTP_PORT=16333
LOCAL_QDRANT_GRPC_PORT=16334
LOCAL_S3_PORT=18333
# Mailpit: SMTP для писем платформы и веб-интерфейс, где их видно.
LOCAL_MAILPIT_SMTP_PORT=1025
LOCAL_MAILPIT_UI_PORT=8025
# LiveKit видеозвонков (срез meetings): только под `--profile meetings`. Порт API и сигнализации и
# порты RTC: ICE объявляет 127.0.0.1, поэтому порт RTC внутри контейнера тот же, что снаружи.
LOCAL_LIVEKIT_PORT=17880
LOCAL_LIVEKIT_RTC_TCP_PORT=17881
LOCAL_LIVEKIT_RTC_UDP_PORT=17882

# Суперпользователь `postgres` обоих серверов — только для администрирования.
LOCAL_POSTGRES_PASSWORD=local-postgres
# Роль миграций `shosai_migrator`: владелец баз и схемы, напрямую в PostgreSQL.
LOCAL_MIGRATOR_PASSWORD=local-migrator
# Роль приложения `shosai_app`: без SUPERUSER и BYPASSRLS, через PgBouncer.
LOCAL_APP_PASSWORD=local-app
# Сколько тестовых баз `shosai_test_<N>` готовить на каждом сервере (1–64).
LOCAL_TEST_DATABASE_COUNT=8

LOCAL_VALKEY_PASSWORD=local-valkey
LOCAL_REDIS_CACHE_PASSWORD=local-redis-cache
LOCAL_QDRANT_API_KEY=local-qdrant
LOCAL_S3_ACCESS_KEY_ID=local-s3-access
LOCAL_S3_SECRET_ACCESS_KEY=local-s3-secret
# Ключ и секрет локального LiveKit (секрет — не короче 32 символов) и пароль его Redis.
LOCAL_LIVEKIT_API_KEY=local-livekit
LOCAL_LIVEKIT_API_SECRET=local-livekit-secret-for-this-machine-only
LOCAL_LIVEKIT_REDIS_PASSWORD=local-livekit-redis
# Куда LiveKit шлёт вебхуки: роль api, запущенная из исходников на хосте.
LOCAL_LIVEKIT_WEBHOOK_URL=http://host.docker.internal:8000/v1/livekit/webhook

# ---------------------------------------------------------------------------
# 2. Настройки процессов бэкенда (backend/src/shosai/core/config). Бэкенд
#    читает только переменные окружения и никогда — файл .env: локально его
#    передаёт uv (`uv run --env-file ../.env shosai …`). Пустая переменная
#    считается незаданной. Списки — через запятую. Ошибка в любой переменной
#    останавливает старт, и сообщение называет переменную, но не значение.
#    При ENVIRONMENT=staging и production действует гейт безопасности
#    (core/config/gate.py), один и тот же; вне него только development:
#    документация API выключена, TRUSTED_PROXY_ADDRESSES и FERNET_KEY заданы,
#    LOG_LEVEL не DEBUG, хранилище — по https, Valkey — по rediss:// или по
#    redis:// на IP-адрес приватной сети (ADR 0042), базы
#    домов — с sslmode=verify-full.
# ---------------------------------------------------------------------------

# Среда процесса: development, staging или production. Обязательна: без неё
# процесс не стартует (урок черновика: незаданная среда молча снимала проверки).
ENVIRONMENT=development

# Деловой часовой пояс платформы (ADR 0058): в нём считаются сутки и месяцы всех итогов
# сервера — выручки, расходов на ИИ и их лимитов, минут, токенов, отчётов; админка
# показывает даты в нём. Пояс IANA; не из браузера и не из профиля.
BUSINESS_TIME_ZONE=Europe/Moscow

# Дом RU. Адреса баз — стандартные адреса libpq (postgresql://…), драйвер выбирает
# код (ADR 0013). В строке запроса допустимы только параметры TLS (sslmode,
# sslrootcert, …); в production — только sslmode=verify-full. Приложение — через
# PgBouncer в режиме транзакций: подготовленные выражения сервером не используются.
HOME_RU_DATABASE_URL=postgresql://shosai_app:local-app@127.0.0.1:16432/shosai
# Миграции дома RU — роль миграций, напрямую в PostgreSQL, мимо PgBouncer.
# Нужна только команде `shosai migrate`; долгоживущим ролям в production её
# не передают, чтобы пароль владельца схемы не жил в процессах приложения.
HOME_RU_MIGRATION_DATABASE_URL=postgresql://shosai_migrator:local-migrator@127.0.0.1:15432/shosai

# Дом EU; в его базе живут и таблицы справочника (§6).
HOME_EU_DATABASE_URL=postgresql://shosai_app:local-app@127.0.0.1:16433/shosai
HOME_EU_MIGRATION_DATABASE_URL=postgresql://shosai_migrator:local-migrator@127.0.0.1:15433/shosai

# Бакет S3 у каждого дома свой (ADR 0044): файлы дома, у EU — ещё и платформы. Адрес
# сервиса, регион подписи, бакет и ключи — у каждого дома свои: провайдеры могут
# различаться. В production — только https. Бакет EU пока тоже в России (Timeweb ru-1),
# до переезда к провайдеру в ЕС перед запуском. Локально — SeaweedFS с двумя бакетами,
# который принимает любой регион подписи.
HOME_RU_S3_ENDPOINT_URL=http://127.0.0.1:18333
HOME_RU_S3_REGION=local
HOME_RU_S3_BUCKET=shosai-ru
HOME_RU_S3_ACCESS_KEY_ID=local-s3-access
HOME_RU_S3_SECRET_ACCESS_KEY=local-s3-secret
HOME_EU_S3_ENDPOINT_URL=http://127.0.0.1:18333
HOME_EU_S3_REGION=local
HOME_EU_S3_BUCKET=shosai-eu
HOME_EU_S3_ACCESS_KEY_ID=local-s3-access
HOME_EU_S3_SECRET_ACCESS_KEY=local-s3-secret

# Общие сервисы плоскости. Valkey — потоки задач TaskIQ, очередь транскрипта,
# блокировки, лимиты запросов, состояние встреч; кэш Redis — только LRU-кэш
# (§4.2). Адреса вида redis://[:пароль@]хост:порт/номер_базы; rediss:// — с TLS.
# Управляемый Valkey стоит вне плоскости: вне разработки — rediss:// или redis:// на
# IP-адрес приватной сети (10/8, 172.16/12, 192.168/16, fc00::/7; ADR 0042).
# Кэш — контейнер внутри плоскости, ему TLS не нужен.
VALKEY_URL=redis://:local-valkey@127.0.0.1:16379/0
REDIS_CACHE_URL=redis://:local-redis-cache@127.0.0.1:16380/0
# Qdrant читает слайс knowledge (S07); пакет F1 эти переменные не использует.
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=local-qdrant

# HTTP. Интерактивная документация API (/docs, /openapi.json); в production —
# только false. По умолчанию false.
API_DOCS_ENABLED=true
# Точные origin, которым разрешены CORS-запросы с учётными данными, через
# запятую: https://host[:port]. «*» не допускается. По умолчанию пусто: кабинет
# обслуживается с того же origin, что и API, и CORS ему не нужен. Правила бакетов
# (shosai files bucket-rules) разрешают загрузку из кабинета на origin PUBLIC_BASE_URL
# и на перечисленных здесь origin — например, dev-сервера кабинета.
CORS_ALLOWED_ORIGINS=
# IP-адреса или сети CIDR edge-прокси, чьим заголовкам X-Forwarded-* верят при
# определении адреса клиента, через запятую. «*» не допускается. Локально прокси
# нет — пусто; в production обязательна.
TRUSTED_PROXY_ADDRESSES=

# Где слушает процесс. Адрес привязки: локально только 127.0.0.1, в контейнере —
# 0.0.0.0 (задаёт образ). HTTP_PORT — публичный порт ролей api и ws, к нему
# ходит edge. OPS_PORT — служебный порт каждой роли: /livez, /readyz и /metrics;
# edge его не проксирует. Порты разные; по умолчанию 8000 и 9100. Несколько
# ролей на одной машине получают разные порты.
BIND_HOST=127.0.0.1
HTTP_PORT=8000
OPS_PORT=9100
# Сокетов WebSocket у одного процесса шлюза ws (голосовой режим Leo, ADR 0070): сверх
# них сокет закрывается с кодом 1013, и клиент переподключается к другому процессу. По
# умолчанию 250.
WS_SOCKETS_PER_PROCESS=250

# Логи и трассировка. Уровень логов: DEBUG, INFO, WARNING или ERROR; по
# умолчанию INFO, в production DEBUG запрещён (§16.7).
LOG_LEVEL=INFO
# Базовый адрес коллектора OpenTelemetry по OTLP/HTTP, например
# http://otel-collector:4318 (путь /v1/traces добавляется сам). Пусто — спаны
# создаются для trace_id в логах, но никуда не отправляются.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Имя сервиса в трассах; по умолчанию shosai.
OTEL_SERVICE_NAME=shosai

# Кольцо ключей Fernet для секретов в базе (токены OAuth, учётные данные MCP);
# имена переменных — черновика, поэтому перенесённые шифртексты расшифровываются.
# Активный ключ шифрует; в production обязателен. Локально — пусто или свой:
# `uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
FERNET_KEY=
# Прежние ключи через запятую — только для расшифровки, на время ротации:
# новый ключ — в FERNET_KEY, старый — сюда; после перешифровки старый убирают.
FERNET_KEYS_PREVIOUS=

# Провайдеры ИИ (core/ai, F6). Ключ OpenRouter: чат, vision, эмбеддинги, rerank,
# картинки, веб-поиск, расшифровка записей, решения Jev. Пусто — провайдер выключен, вызовы
# отклоняются; вне разработки гейт требует ключ. Базовый адрес задают только для прокси;
# пусто — адрес провайдера. Цены OpenRouter сверяются раз в сутки по его публичному списку
# моделей; адрес списка — от OPENROUTER_BASE_URL.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# Ключ управления OpenRouter (management key): только для отчёта о балансе на экране
# оператора; обычный ключ получает 403. Пусто — баланс в отчёте «неизвестен».
OPENROUTER_MANAGEMENT_KEY=
# OpenAI Realtime: потоковая расшифровка живой встречи (gpt-live-transcribe и другие).
# Пусто — выключен; вне разработки гейт требует ключ. Адрес — wss://, только для прокси.
OPENAI_API_KEY=
OPENAI_REALTIME_URL=
# Gemini Live: синхронный перевод и голосовой ассистент. Те же правила; адрес — https://.
GOOGLE_LIVE_API_KEY=
GOOGLE_LIVE_BASE_URL=
# Mistral OCR: сканы и картинки документов (модель mistral-ocr-4-1). Те же правила.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
# Семафор провайдеров (§3.5): вызовов и живых сессий в полёте на весь план, ниже квоты
# провайдера по договору. OpenRouter — 292 в расчётной точке; сессии — по квотам OpenAI и Google.
OPENROUTER_SLOTS=292
MISTRAL_SLOTS=16
OPENAI_REALTIME_SLOTS=1000
GOOGLE_LIVE_SLOTS=1000

# Контроль расходов на ИИ (core/ai/spend, §3.6). Потолки платформы в долларах: общие за час
# и сутки и по платформенным аккаунтам (демо лендинга, ассистент справки, Leo админ-панели,
# системные задачи).
# Потолки пользователя приходят от вызывающего по тарифу. Ни один потолок не останавливает
# встречи и обычную расшифровку (inv-13).
AI_GLOBAL_HOURLY_USD=400
AI_GLOBAL_DAILY_USD=4000
AI_LANDING_DEMO_HOURLY_USD=5
AI_LANDING_DEMO_DAILY_USD=20
AI_HELP_ASSISTANT_HOURLY_USD=5
AI_HELP_ASSISTANT_DAILY_USD=20
AI_ADMIN_ASSISTANT_HOURLY_USD=5
AI_ADMIN_ASSISTANT_DAILY_USD=20
AI_SYSTEM_HOURLY_USD=10
AI_SYSTEM_DAILY_USD=50
# Аварийный выключатель: true — дорогие вызовы стоят всегда. Оператор включает его на время
# командой `shosai ai kill-switch engage --reason "…" [--hours 24]`.
AI_KILL_SWITCH=false
# Аренда резерва: не снятый резерв умершего процесса освобождается по её окончании (секунды).
AI_RESERVATION_LEASE_SECONDS=300
# Траты пользователя за сутки делового пояса, после которых оператор получает событие
# ai.user_spend.exceeded, раз в сутки на человека; 0 — не следить.
AI_USER_DAILY_ALERT_USD=20

# Почта (core/email, F6): один SMTP-сервер, два ящика по виду письма (F6-C11). Timeweb
# требует From = логин ящика, поэтому ящик — это адрес и пароль. Письма аккаунта (коды,
# сбросы, приветствие) уходят из ACCOUNT, остальные — из NOTIFICATIONS. В разработке —
# Mailpit на 127.0.0.1:1025 без TLS и без входа; вне разработки гейт требует TLS
# (SMTP_SECURITY=tls для 465 или starttls для 587) и оба ящика с паролями.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_ACCOUNT_USER=
SMTP_ACCOUNT_PASSWORD=
SMTP_NOTIFICATIONS_USER=
SMTP_NOTIFICATIONS_PASSWORD=
# Имя отправителя в From; адрес — логин ящика.
EMAIL_SENDER_NAME=Shosai
# Адрес сайта и кабинета: ссылки и картинки писем, origin кабинета в правилах бакетов;
# адрес поддержки — в подвале каждого письма.
PUBLIC_BASE_URL=https://shosai.tech
SUPPORT_EMAIL=support@shosai.tech
# Секрет подписи ссылок отписки (HMAC-SHA256, F6-C21), не короче 32 символов; вне
# разработки обязателен. Ссылки не истекают: смена секрета ломает ссылки во всех
# отправленных письмах, поэтому секрет не меняют без причины. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(48))". Пусто — письма без ссылки.
EMAIL_LINK_SECRET=
# JWT-секрет черновика (whisperer.one): только чтобы ссылки отписки из писем, отправленных
# до переезда, продолжали работать; отписывают от новостей в доме RU. Убрать через 24
# месяца после переезда. Пусто — такие ссылки ничего не меняют.
DRAFT_UNSUBSCRIBE_SECRET=

# Ограничения на пользователя без калибровки (§3.7): интерактивных потоков и живых сессий
# одновременно (встречи считаются, но не отклоняются), контекст в токенах, картинок на
# вызов и размер картинки в мегабайтах. Сверх — отказ до обращения к провайдеру.
AI_INTERACTIVE_STREAMS=2
AI_MAX_CONTEXT_TOKENS=32000
AI_MAX_IMAGES=6
AI_MAX_IMAGE_MB=8

# Курс ЦБ (core/exchange_rates, ADR 0036): дневные курсы USD и EUR раз в 6 часов.
CBR_DAILY_URL=https://www.cbr-xml-daily.ru/daily_json.js

# identity (ADR 0045). Кольцо ключей подписи токенов «kid:секрет» через запятую: первый
# подписывает, остальные только проверяют; kid — строчные латинские буквы, цифры, дефис.
# Ключ черновика (JWT_SECRET whisperer.one, DATA_MAPPING R6) добавляется под kid «d»:
# им подписаны токены без заголовка kid, и пользователи не разлогиниваются при переезде.
# Новый ключ — не короче 32 байт; kid, начинающийся с «dev», вне разработки не пускается.
# Сгенерировать: python -c "import secrets; print('k1:' + secrets.token_urlsafe(48))".
IDENTITY_TOKEN_KEYS=dev:development-signing-key-not-for-staging-or-production
# Ключ HMAC адреса в каталоге (§6, §15), не короче 32 байт; хранится вне базы. Смена ключа
# делает каталог нечитаемым — его не меняют. Значение на «dev» вне разработки не пускается.
IDENTITY_DIRECTORY_HMAC_KEY=dev-directory-hmac-key-not-for-staging-or-production
# Стоимость bcrypt (4–15): 12 вне разработки, ≈ 250 мс на хеш в отдельном пуле потоков.
IDENTITY_PASSWORD_HASH_ROUNDS=12
# Cloudflare Turnstile (ADR 0045): ключ сайта виджета (публичный, уходит в кабинет) и секрет
# серверной проверки. Пусто — капча выключена (только разработка); вне её оба обязательны.
IDENTITY_TURNSTILE_SITE_KEY=
IDENTITY_TURNSTILE_SECRET_KEY=
# Cookie сессии (meetassist_refresh, meetassist_csrf — имена выпущенных клиентов): Secure
# всегда вне разработки; false — только для кабинета по http на чужом хосте. Домен cookie —
# пусто для хоста запроса.
IDENTITY_COOKIE_SECURE=true
IDENTITY_COOKIE_DOMAIN=
# Вход через соцсети (ID-D8): провайдер включён, когда задан его client id. Яндекс и VK
# показываются из России и неизвестной страны, Google и GitHub — остальным. Адрес возврата
# в настройках приложения провайдера: {PUBLIC_BASE_URL}/v1/auth/social/<провайдер>/callback;
# у Яндекса второй — …/v1/auth/social/yandex/token-page. VK ID работает без секрета (PKCE):
# IDENTITY_VK_CLIENT_ID — числовой «ID приложения» из кабинета VK ID, не защищённый ключ и не
# сервисный токен; им же запускается кнопка OneTap в кабинете.
IDENTITY_YANDEX_CLIENT_ID=
IDENTITY_YANDEX_CLIENT_SECRET=
IDENTITY_VK_CLIENT_ID=
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_GOOGLE_CLIENT_SECRET=
IDENTITY_GITHUB_CLIENT_ID=
IDENTITY_GITHUB_CLIENT_SECRET=
# Перенос аккаунта между домами РФ и ЕС (§6): закрыт, пока юридическая проверка (§22)
# не пройдена. true — только по решению владельца после ответа юриста.
IDENTITY_TRANSFERS_ALLOWED=false
# Единственный администратор (ADR 0049): вход по отдельному адресу кабинета (VITE_ADMIN_LOGIN_PATH
# во frontend/.env) с этим логином и паролем. Хранится только bcrypt-хэш пароля; его печатает
# `uv run shosai identity admin-password-hash` (пароль вводится без эха, не короче 16 знаков).
# Хэш — в одинарных кавычках: иначе Compose примет `$2b$12$…` за подстановку переменных.
# Без обеих переменных админка закрыта, а production не запускается.
IDENTITY_ADMIN_USERNAME=
IDENTITY_ADMIN_PASSWORD_HASH=

# --- Файлы (срез files) ---
# Адрес edge, через который отдаются скачивания (FL-D9, ADR 0055 п. 8): ссылка вида
# {адрес}/{дом}{путь подписанной ссылки бакета}; edge отдаёт байты бакета дома с
# X-Content-Type-Options: nosniff и Content-Security-Policy: sandbox. Локально без edge — пусто:
# ссылки ведут прямо в бакет. Вне разработки обязателен; на staging — https://shosai.tech/dl.
FILES_DOWNLOAD_BASE_URL=

# --- Leo (срез agent) ---
# Модель OpenRouter стандартного уровня, которой отвечает Leo, пока срез studio не публикует
# маршруты моделей (ADR 0068 AG-D4). Её цены приходят ежедневной синхронизацией OpenRouter;
# модель без цены отклоняется (`model_unpriced`). Вне разработки обязательна. Запасная — того же
# уровня, по желанию: ей переходит вызов, когда основная недоступна.
AGENT_STANDARD_MODEL=google/gemini-3.8-flash
AGENT_STANDARD_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# Служебная модель Leo: пишет заголовки тредов и сжимает их старые ходы в сводку, вне пути ответа.
# Вне разработки обязательна; запасная — по желанию.
AGENT_UTILITY_MODEL=google/gemini-3.8-flash
AGENT_UTILITY_FALLBACK_MODEL=
# Модель OpenRouter, что рисует картинки Leo администратора (`images.draw`, шаг 16b2):
# картинка — объект платформы в бакете EU, в ответе — по ссылке. Цена — за токены картинки, из
# ежедневной синхронизации OpenRouter; модель без цены отклоняется. По желанию: без неё
# инструмент отвечает, что недоступен. Подходит модель каталога OpenRouter с выходом «image».
AGENT_IMAGE_MODEL=
# Трассировка LangChain в LangSmith, которую приносит каркас хода LangGraph (AG-D14). Выключена
# всегда: разговоры не покидают платформу, и процесс с любой из них во включённом виде не запускается.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Токен GitHub для хранилища навыков Studio (только чтение публичных репозиториев, без прав):
# поднимает лимит API GitHub с 60 до 5 000 запросов в час на процесс. По желанию: без него навыки
# ставятся, пока лимит не исчерпан, а потом отвечают 429 до сброса. Секрет — не в Git.
AGENT_GITHUB_TOKEN=

# --- Голосовой режим Leo (срез capture, ADR 0070) ---
# Модель Gemini Live, с которой говорит голосовой режим (WS /v1/ws/voice на роли ws). Голос Charon
# выбран владельцем и не настраивается; цены модели — в каталоге F6 (`model_unpriced` без них).
# Ключ — GOOGLE_LIVE_API_KEY в разделе ИИ. По умолчанию — gemini-3.8-live.
CAPTURE_VOICE_MODEL=gemini-3.8-live

# --- Слой решений Leo (срез decisions) ---
# Закреплённая версия Jev, которую спрашивают все политики решений (ADR 0026, ADR 0069): пороги
# откалиброваны под один снимок, поэтому псевдоним (`~typesafe/jev-latest`) не принимается.
# Цена приходит ежедневной синхронизацией OpenRouter. По умолчанию — typesafe/jev-1.13.
DECISIONS_JEV_MODEL=typesafe/jev-1.13
# Сколько вызовов Jev процесс держит в полёте, опоздавшие тоже; сверх этого решение — правило
# (`busy`), так что медленный Jev не копит вызовы в процессе.
DECISIONS_MAX_IN_FLIGHT=64
# Модель, которая пишет синтетические случаи наборов калибровки, и независимая модель другого
# поставщика, которая размечает их вслепую (ADR 0069 DL-D8). Только для команды оператора
# `shosai decisions dataset …`; цены — ежедневной синхронизацией OpenRouter.
DECISIONS_GENERATOR_MODEL=deepseek/deepseek-v4-flash
DECISIONS_LABELLER_MODEL=minimax/minimax-m3.1-flash

# --- Память Leo (срез memory) ---
# Модель OpenRouter, которая находит утверждения о человеке в ходе и во встрече, пишет сводку
# памяти и читает поле «Ask or update», пока срез studio не даст маршруты моделей; запасная —
# по желанию. Вызовы — фоновая работа человека вне его токенов Leo. По умолчанию — gemini-3.8-flash.
MEMORY_MODEL=google/gemini-3.8-flash
MEMORY_FALLBACK_MODEL=
# Сколько основная модель памяти рассуждает перед ответом (`reasoning.effort` OpenRouter): minimal, low,
# medium или high; по умолчанию minimal. Ответ — короткий JSON: на длинном сообщении gemini-3.8-flash
# по умолчанию тратила на рассуждение 573 из 600 токенов ответа, и разбор хода не сохранял ничего
# (замер 2026-10-27). Запасная модель отвечает как решит её провайдер.
MEMORY_REASONING=minimal
# Модель эмбеддингов, которой память превращает факты и вопросы в векторы (ADR 0071 MM-D6,
# решение владельца): 1 024 измерения из её 128–3 072. Смена модели — проход перевычисления
# векторов по курсору; вспоминание не сравнивает векторы двух моделей. По умолчанию —
# google/gemini-embedding-2; цена приходит ежедневной синхронизацией OpenRouter.
MEMORY_EMBEDDING_MODEL=google/gemini-embedding-2

# --- Модели и промты (срез studio) ---
# Линия уровня модели каталога (ADR 0074 ST-D4): цена выхода в долларах за миллион токенов, выше
# которой цена предлагает уровень frontier. Предложение ничего не меняет, пока его не подтвердит
# админ на экране AI-моделей; списанное по старому уровню не пересчитывается. По умолчанию — 6.
STUDIO_FRONTIER_OUTPUT_USD_PER_M=6

# --- Встречи (срез meetings) ---
# Модель OpenRouter, которая пишет находки встречи и запись Leo по шаблону, пока срез studio
# не назначает модель роли `notes` (SM-5). Её цены приходят ежедневной синхронизацией OpenRouter;
# модель без цены отклоняется (`model_unpriced`). Вне разработки обязательна. Запасная — по
# желанию: ей переходит вызов, когда основная недоступна.
NOTES_MODEL=google/gemini-3.8-flash
NOTES_FALLBACK_MODEL=
# Модель OpenRouter, которая расшифровывает импортированные записи и записи с десктопа, с
# таймстемпами сегментов (на них ложатся говорящие из pyannote). Вне разработки обязательна.
NOTES_TRANSCRIBE_MODEL=openai/whisper-large-v3
NOTES_TRANSCRIBE_FALLBACK_MODEL=
# Пределы одного вызова ffprobe или ffmpeg (MT-D10): секунд по часам и процессору, мегабайт
# адресного пространства. Превысивший предел процесс завершается, запись — media_unreadable.
NOTES_MEDIA_SECONDS=300
NOTES_MEDIA_MEMORY_MB=1024

# --- Видеозвонки (срез meetings, ADR 0072) ---
# LiveKit задаётся целиком или не задаётся вовсе: без него приложение работает, а маршруты
# звонков отвечают 503 video_unavailable. LIVEKIT_URL — адрес сигнализации для клиентов (вне
# разработки только wss://), LIVEKIT_API_URL — серверный API внутри плоскости, без префикса пути.
# Ключ и секрет подписывают пропуска и проверяют вебхуки; секрет — не короче 32 символов.
# Значения ниже — локальный LiveKit из `docker compose -f compose.dev.yaml --profile meetings up`.
LIVEKIT_URL=ws://127.0.0.1:17880
LIVEKIT_API_URL=http://127.0.0.1:17880
LIVEKIT_API_KEY=local-livekit
LIVEKIT_API_SECRET=local-livekit-secret-for-this-machine-only
# Потолок участников звонка над значением тарифа `room_participants` (MR-D2): 50; на стейджинге 4.
MEETINGS_ROOM_PARTICIPANTS_CEILING=50
# Видеозаписей звонков одновременно на всю платформу и длина одной, в минутах (MR-D14: на
# стейджинге 1 и 30).
MEETINGS_RECORDINGS_CONCURRENT=1
MEETINGS_RECORDING_MAX_MINUTES=30
# Адрес бакета дома, каким его видит egress, если не тот, что у API; пусто — адрес дома. В
# разработке egress живёт в сети Compose и видит хранилище как сервис s3.
MEETINGS_EGRESS_S3_ENDPOINT_RU=http://s3:8333
MEETINGS_EGRESS_S3_ENDPOINT_EU=http://s3:8333
# Prometheus стека наблюдаемости: узлы, трафик и история LiveKit на экране администратора (A8).
# В сети Compose — http://prometheus:9090; процессу на хосте — опубликованный порт локального стека.
# Не отвечает — экран показывает «нет данных», остальное работает.
MEETINGS_PROMETHEUS_URL=http://127.0.0.1:9090
# Предел памяти контейнера LiveKit в МиБ, как его задаёт выкладка: доля памяти узла на экране
# администратора считается от него; пусто — «нет данных». В compose.dev.yaml — 384.
MEETINGS_LIVEKIT_MEMORY_LIMIT_MB=384

# --- Подключённые сервисы (срез connectors, ADR 0075) ---
# Публичный адрес API, на который провайдеры возвращают браузер после согласия:
# <адрес>/v1/connectors/oauth/<провайдер>/callback — этот адрес регистрируется в каждом
# приложении OAuth. Пусто — адрес писем (EMAIL_PUBLIC_BASE_URL). Приложения провайдеров
# (CONNECTORS_<КЛЮЧ>_CLIENT_ID и _CLIENT_SECRET) добавляются с шагом каждого провайдера;
# без них приложения провайдера не предлагаются.
CONNECTORS_PUBLIC_BASE_URL=
# Приложение OAuth 2.0 (3LO) в консоли разработчика Atlassian (Jira, затем Confluence): id и секрет
# задаются вместе или не задаются оба. Обратный адрес приложения — <адрес>/v1/jira/oauth/callback.
CONNECTORS_ATLASSIAN_CLIENT_ID=
CONNECTORS_ATLASSIAN_CLIENT_SECRET=
# Основной проект Google (Календарь и Диск) и проект «Shosai Mail» (Gmail, CN-D5): id и секрет
# каждого — вместе или никак. Обратный адрес обоих — <адрес>/v1/connectors/oauth/google/callback.
# *_TESTING=true — проект в статусе Testing: refresh-токены живут 7 дней, строка в Settings ›
# Connectors заранее говорит, когда переподключить. «Shosai Mail» в Testing до бюджета на CASA.
CONNECTORS_GOOGLE_CLIENT_ID=
CONNECTORS_GOOGLE_CLIENT_SECRET=
CONNECTORS_GOOGLE_TESTING=false
CONNECTORS_GOOGLE_MAIL_CLIENT_ID=
CONNECTORS_GOOGLE_MAIL_CLIENT_SECRET=
CONNECTORS_GOOGLE_MAIL_TESTING=true

# --- Оповещения о бизнес-событиях (срез alerting, F5-D5) ---
# Тикет о дневном расходе человека на ИИ и уведомление об удалённом аккаунте уходят в Alertmanager,
# оттуда — в чат мониторинга: только id, суммы и ссылка на карточку в админке, без имён и почты.
# false — событие принимается и пишется в журнал, оповещение не уходит. На staging и в production — true.
ALERTING_ENABLED=false
# Адрес Alertmanager стека наблюдаемости (deploy/observability): роли и стек — в одной сети Compose.
ALERTING_ALERTMANAGER_URL=http://alertmanager:9093

# ---------------------------------------------------------------------------
# 3. Тесты бэкенда (ADR 0009). Тесты читают только переменные с префиксом TEST_;
#    рабочие переменные из раздела 2 им не видны. Имя базы в каждом адресе —
#    shosai_test: харнесс сам добавляет номер захваченного слота
#    (shosai_test_<N> на обоих серверах) и отказывается работать, если хост
#    не петлевой, имя базы другое или адрес базы, Valkey или кэша совпадает с
#    рабочим.
#    Запуск из backend/: `uv run --env-file ../.env pytest`.
# ---------------------------------------------------------------------------

# Роль приложения через PgBouncer дома: так тесты видят RLS, как в production.
TEST_HOME_RU_DATABASE_URL=postgresql://shosai_app:local-app@127.0.0.1:16432/shosai_test
TEST_HOME_EU_DATABASE_URL=postgresql://shosai_app:local-app@127.0.0.1:16433/shosai_test
# Роль миграций напрямую: захват слота, миграции, очистка и сверка каталога.
TEST_HOME_RU_MIGRATION_DATABASE_URL=postgresql://shosai_migrator:local-migrator@127.0.0.1:15432/shosai_test
TEST_HOME_EU_MIGRATION_DATABASE_URL=postgresql://shosai_migrator:local-migrator@127.0.0.1:15433/shosai_test
# Сколько слотов перебирать при захвате (1–15); не больше LOCAL_TEST_DATABASE_COUNT.
TEST_DATABASE_SLOTS=8
# Valkey и кэш Redis — без номера базы: номер слота и есть номер базы прогона
# (база 0 — у разработки). Хост — только петлевой.
TEST_VALKEY_URL=redis://:local-valkey@127.0.0.1:16379
TEST_REDIS_CACHE_URL=redis://:local-redis-cache@127.0.0.1:16380
# Бакеты домов — те же, что у разработки: прогон пишет только под tests/slot-<N>/ в
# каждом и очищает этот префикс после каждого теста. Адрес сервиса — только петлевой.
TEST_HOME_RU_S3_ENDPOINT_URL=http://127.0.0.1:18333
TEST_HOME_RU_S3_REGION=local
TEST_HOME_RU_S3_BUCKET=shosai-ru
TEST_HOME_RU_S3_ACCESS_KEY_ID=local-s3-access
TEST_HOME_RU_S3_SECRET_ACCESS_KEY=local-s3-secret
TEST_HOME_EU_S3_ENDPOINT_URL=http://127.0.0.1:18333
TEST_HOME_EU_S3_REGION=local
TEST_HOME_EU_S3_BUCKET=shosai-eu
TEST_HOME_EU_S3_ACCESS_KEY_ID=local-s3-access
TEST_HOME_EU_S3_SECRET_ACCESS_KEY=local-s3-secret
# LiveKit для тестов среза meetings — локальный из `--profile meetings`. Без этих переменных
# тесты против LiveKit пропускаются (профиль поднимают только сессии meetings); CI задаёт их.
# TEST_LIVEKIT_URL=ws://127.0.0.1:17880
# TEST_LIVEKIT_API_URL=http://127.0.0.1:17880
# TEST_LIVEKIT_API_KEY=local-livekit
# TEST_LIVEKIT_API_SECRET=local-livekit-secret-for-this-machine-only
