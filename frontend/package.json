{
  "name": "frontend",
  "version": "2.2.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "lint:architecture": "node src/scripts/check-architecture.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "i18n:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./src/scripts/test-hooks.mjs src/scripts/check-i18n.ts",
    "i18n:rtl-smoke": "node src/scripts/rtl-smoke.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./src/scripts/test-hooks.mjs --test \"src/**/*.test.ts\"",
    "prepare": "husky",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts",
    "doctor": "REACT_DOCTOR_NO_TELEMETRY=1 react-doctor --verbose"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@floating-ui/dom": "^1.8.0",
    "@fullcalendar/react": "^7.1.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.5",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "country-flag-icons": "1.6.20",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.0.0",
    "frimousse": "^0.4.0",
    "geist": "^1.7.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.1",
    "simple-icons": "^16.34.0",
    "sonner": "^2.0.8",
    "temporal-polyfill": "^1.0.5",
    "thinking-orbs": "^0.3.2",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "react-doctor": "^0.9.17",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
