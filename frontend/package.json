{
  "name": "frontend",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "build": "vite build && node tooling/check-dist.ts",
    "preview": "vite preview",
    "typecheck": "node tooling/generate-message-types.ts && tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "vitest run src/scripts/i18n.test.ts",
    "i18n:rtl-smoke": "node src/scripts/rtl-smoke.mjs",
    "api:types": "openapi-typescript ../backend/openapi.json --output src/lib/api/generated/schema.d.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "generate:presets": "node src/scripts/generate-theme-presets.ts",
    "prepare": "husky",
    "doctor": "REACT_DOCTOR_NO_TELEMETRY=1 react-doctor --verbose"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/raleway": "5.3.0",
    "@fontsource-variable/roboto-slab": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fullcalendar/react": "^7.1.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "^9.2.5",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "country-flag-icons": "1.6.20",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.0.0",
    "frimousse": "^0.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.2",
    "react-router": "8.4.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.1",
    "simple-icons": "^16.34.0",
    "sonner": "^2.0.8",
    "temporal-polyfill": "^1.0.5",
    "thinking-orbs": "^0.3.2",
    "use-intl": "4.14.8",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "^2.5.15",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "3.0.1",
    "openapi-typescript": "7.13.0",
    "playwright-core": "^1.63.0",
    "react-doctor": "^0.9.17",
    "tailwindcss": "^4.1.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
