# Серверы edge. Переменные SHOSAI_* подставляет entrypoint образа при старте (envsubst):
#   SHOSAI_SERVER_NAME           домен (staging: shosai.tech);
#   SHOSAI_API_UPSTREAM          адрес api, host:port;
#   SHOSAI_WS_UPSTREAM           адрес шлюза ws, host:port;
#   SHOSAI_TLS_CERTIFICATE       цепочка сертификата; SHOSAI_TLS_CERTIFICATE_KEY — его ключ;
#   SHOSAI_CSP_STORAGE_ORIGINS   origin-ы бакетов домов через пробел (аватары, выгрузки);
#   SHOSAI_DOWNLOAD_RU_ORIGIN, SHOSAI_DOWNLOAD_EU_ORIGIN — бакеты домов для скачивания файлов
#                                (templates/shosai/downloads.conf.template);
#   SHOSAI_ROBOTS_TAG            X-Robots-Tag (staging: "noindex, nofollow");
#   SHOSAI_RESOLVER              DNS, у которого edge переспрашивает адреса api и ws (Docker: 127.0.0.11);
#   SHOSAI_OTEL_ENDPOINT         коллектор OpenTelemetry, host:port его OTLP/gRPC (otel.conf.template);
#   SHOSAI_OTEL_TRACE            on — трейсы edge в коллектор, off — без трейсов (otel.conf.template).
#   SHOSAI_GRAFANA_SERVER_NAME, SHOSAI_GRAFANA_UPSTREAM — адрес Grafana и её процесс (grafana.conf.template).

# Процессы плоскости пересоздаются при выкладке и получают новые адреса: edge переспрашивает их у DNS, а не
# держит адрес, полученный при старте (иначе после выкладки бэкенда — 502).
resolver ${SHOSAI_RESOLVER} valid=10s ipv6=off;

upstream shosai_api {
    zone shosai_api 64k;
    server ${SHOSAI_API_UPSTREAM} resolve;
    keepalive 32;
    # Короче простоя сервера api (75 с): edge закрывает соединение первым.
    keepalive_timeout 60s;
}

upstream shosai_ws {
    zone shosai_ws 64k;
    least_conn;
    server ${SHOSAI_WS_UPSTREAM} resolve;
}

# HTTP: только проверки ACME для certbot (F4-D7) и переход на HTTPS.
server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 308 https://${SHOSAI_SERVER_NAME}$request_uri;
    }
}

# Проверка здоровья контейнера: только изнутри.
server {
    listen 127.0.0.1:8081;
    access_log off;

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
}

# Счётчики соединений для nginx-экспортёра (F5, target architecture §16.1). Порт не публикуется:
# его видят только контейнеры плоскости, и отвечает он только частным адресам.
server {
    listen 8082;
    access_log off;

    location = /stub_status {
        stub_status;
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
    }

    location / {
        return 404;
    }
}

server {
    listen 8443 ssl default_server;
    listen [::]:8443 ssl default_server;
    http2 on;
    server_name ${SHOSAI_SERVER_NAME};

    ssl_certificate ${SHOSAI_TLS_CERTIFICATE};
    ssl_certificate_key ${SHOSAI_TLS_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:shosai_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/shosai/csp-hashes.conf;
    include /tmp/nginx/shosai/security-headers.conf;

    limit_req zone=shosai_per_ip burst=100 nodelay;
    limit_conn shosai_conn_per_ip 1000;

    root /usr/share/nginx/html;

    # Публичного сайта ещё нет (F4-D5): корень ведёт на вход в кабинет.
    location = / {
        return 302 /app/login;
    }

    # Файлы сборки с хешем в имени не меняются никогда.
    location ^~ /app/assets/ {
        include /tmp/nginx/shosai/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ^~ /app/ {
        include /tmp/nginx/shosai/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /app/index.html;
    }

    # Пути кабинета вне /app/ (ADR 0021 §3; frontend/tooling/cabinet-paths.ts): его index.html.
    # Префиксы /app/ выше помечены ^~, поэтому сюда не попадают.
    location ~ ^/(app|admin|oauth/callback|unauthorized)(/|$) {
        include /tmp/nginx/shosai/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files /app/index.html =404;
    }

    # Скачивание файлов из бакетов домов (FL-D9). Шаблон с маской: без бакетов файла нет.
    include /tmp/nginx/shosai/downloads*.conf;

    # WebSocket: шлюз ws, наименее загруженный процесс; рукопожатие — 5 с (§4.3).
    location /v1/ws/ {
        otel_trace $shosai_otel_trace;
        otel_trace_context inject;
        proxy_pass http://shosai_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $shosai_connection_upgrade;
        include /etc/nginx/shosai/proxy-headers.conf;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Страница, на которую виджет Яндекс ID возвращает окно входа (identity, шаг 5): её скрипт отдаёт
    # токен окну кабинета. Заголовки безопасности кабинета ей не подходят: их CSP не пускает её скрипт
    # (у страницы своя строгая CSP от бэкенда), а Cross-Origin-Opener-Policy рвёт связь окна входа с
    # окном кабинета, и токен некуда отдать — остаётся белая страница. add_header здесь отменяет
    # наследование заголовков сервера; HSTS и X-Robots-Tag задаются заново, nosniff ставит бэкенд.
    location = /v1/auth/social/yandex/token-page {
        otel_trace $shosai_otel_trace;
        otel_trace_context inject;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Robots-Tag "${SHOSAI_ROBOTS_TAG}" always;
        proxy_pass http://shosai_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        include /etc/nginx/shosai/proxy-headers.conf;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
    }

    # Нативный импорт записи (meetings шаг 9b): тело до 25 МиБ идёт в API потоком, без буфера
    # edge, — буфер отвечал клиентам 408 (2adfda623). Тело не повторить, поэтому без повтора;
    # ответ ждётся до 60 с: после последнего байта API дописывает объект в бакет.
    location = /v1/me/sessions/import {
        otel_trace $shosai_otel_trace;
        otel_trace_context inject;
        proxy_pass http://shosai_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        include /etc/nginx/shosai/proxy-headers.conf;
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_request_buffering off;
        proxy_next_upstream off;
        client_max_body_size 32m;
    }

    # API: подключение 2 с, ответ 30 с, один повтор только для идемпотентных методов (§4.3).
    # Часть записи встречи — до 32 МБ: слайс встреч задаёт размер части не больше.
    location /v1/ {
        otel_trace $shosai_otel_trace;
        otel_trace_context inject;
        proxy_pass http://shosai_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        include /etc/nginx/shosai/proxy-headers.conf;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
        client_max_body_size 32m;
    }

    # Картинки, на которые ссылаются письма.
    location /email/ {
        otel_trace $shosai_otel_trace;
        otel_trace_context inject;
        proxy_pass http://shosai_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        include /etc/nginx/shosai/proxy-headers.conf;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
    }

    # Остальные пути — публичного сайта, которого ещё нет.
    location / {
        return 404;
    }
}
