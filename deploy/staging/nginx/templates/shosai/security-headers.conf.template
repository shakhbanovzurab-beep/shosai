# Заголовки безопасности каждого ответа edge. add_header в location отменяет наследование, поэтому
# каждый location с собственными заголовками подключает этот файл заново.
#
# CSP (ADR 0019, ADR 0047): свои скрипты и встроенные — по хешам сборки ($shosai_csp_script_hashes);
# снаружи — только то, что кабинет действительно грузит:
#   challenges.cloudflare.com — Turnstile (ID-D1);
#   id.vk.ru (фрейм OneTap), login.vk.ru, oauth.vk.ru, api.vk.ru — кнопка VK ID (SDK @vkid/sdk);
#   accounts.google.com — кнопка Google Identity; yastatic.net, autofill.yandex.ru (её фреймы и
#   запрос версии), passport.yandex.ru — кнопка Яндекс ID (шаг 10c);
#   www.googletagmanager.com и хосты разрешённых тегов (GA4, Google Ads, Яндекс Метрика) — ADR 0047;
#   api.open-meteo.com — погода в шапке; SHOSAI_CSP_STORAGE_ORIGINS — бакеты домов (аватары, выгрузки).
# 'unsafe-inline' только для стилей: React и Radix пишут style-атрибуты, скрипты встроенными не бывают.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' $shosai_csp_script_hashes https://challenges.cloudflare.com https://accounts.google.com https://yastatic.net https://www.googletagmanager.com https://mc.yandex.ru; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob: ${SHOSAI_CSP_STORAGE_ORIGINS} https://*.googleusercontent.com https://www.googletagmanager.com https://*.google-analytics.com https://www.google.com https://googleads.g.doubleclick.net https://mc.yandex.ru https://mc.yandex.com; font-src 'self' data:; media-src 'self' blob: ${SHOSAI_CSP_STORAGE_ORIGINS}; connect-src 'self' wss://${SHOSAI_SERVER_NAME} ${SHOSAI_CSP_STORAGE_ORIGINS} https://api.open-meteo.com https://accounts.google.com https://autofill.yandex.ru https://id.vk.ru https://login.vk.ru https://oauth.vk.ru https://api.vk.ru https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com https://googleads.g.doubleclick.net https://mc.yandex.ru https://mc.yandex.com; frame-src https://challenges.cloudflare.com https://id.vk.ru https://accounts.google.com https://autofill.yandex.ru https://passport.yandex.ru https://www.googletagmanager.com https://td.doubleclick.net https://mc.yandex.ru https://mc.yandex.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
# Без includeSubDomains и preload: поддомены shosai.tech пока не обязаны держать TLS.
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
# Микрофон и камера — запись встреч в браузере; геопозиция — согласие share_location (погода).
add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), display-capture=(self), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()" always;
# Staging закрыт от индексации (F4-D5); production задаёт своё значение.
add_header X-Robots-Tag "${SHOSAI_ROBOTS_TAG}" always;
