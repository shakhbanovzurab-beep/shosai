          "alertname": "LeoTurnFailuresBudgetBurnFast",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "slo": "leo_turn_failures",
                "journey": "leo_turn"
              },
              "exp_annotations": {
                "summary": "Ходы Leo заканчиваются сбоем платформы",
                "description": "Мы обещаем, что ход Leo заканчивается без сбоя платформы в 99 % случаев. Сбоев сейчас очень много: если так продолжится, обещание на этот месяц будет нарушено примерно через 2 дня.",
                "runbook": "docs/runbooks/alerts.md#slo-budget-burn",
                "dashboard": "/d/journey-leo-turn"
              }
            }
          ]
        },
        {
          "eval_time": "80m",
          "alertname": "LeoTurnFailuresBudgetBurnSlow",
