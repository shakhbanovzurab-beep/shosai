{
  "groups": [
    {
      "name": "agent-slo-recording",
      "rules": [
        {
          "record": "slo:leo_turn_failures:bad_ratio:rate5m",
          "expr": "(sum(rate(shosai_agent_turns_total{outcome=~\"failed|process_lost|turn_deadline\"}[5m])) or vector(0)) / sum(rate(shosai_agent_turns_total[5m]))",
          "labels": {
            "slo": "leo_turn_failures",
            "journey": "leo_turn"
          }
        },
        {
          "record": "slo:leo_turn_failures:bad_ratio:rate30m",
          "expr": "(sum(rate(shosai_agent_turns_total{outcome=~\"failed|process_lost|turn_deadline\"}[30m])) or vector(0)) / sum(rate(shosai_agent_turns_total[30m]))",
          "labels": {
            "slo": "leo_turn_failures",
            "journey": "leo_turn"
          }
        },
        {
          "record": "slo:leo_turn_failures:bad_ratio:rate1h",
          "expr": "(sum(rate(shosai_agent_turns_total{outcome=~\"failed|process_lost|turn_deadline\"}[1h])) or vector(0)) / sum(rate(shosai_agent_turns_total[1h]))",
          "labels": {
            "slo": "leo_turn_failures",
            "journey": "leo_turn"
          }
        },
        {
          "record": "slo:leo_turn_failures:bad_ratio:rate6h",
          "expr": "(sum(rate(shosai_agent_turns_total{outcome=~\"failed|process_lost|turn_deadline\"}[6h])) or vector(0)) / sum(rate(shosai_agent_turns_total[6h]))",
          "labels": {
            "slo": "leo_turn_failures",
            "journey": "leo_turn"
          }
        },
        {
          "record": "slo:leo_turn_failures:bad_ratio:rate3d",
          "expr": "(sum(rate(shosai_agent_turns_total{outcome=~\"failed|process_lost|turn_deadline\"}[3d])) or vector(0)) / sum(rate(shosai_agent_turns_total[3d]))",
          "labels": {
            "slo": "leo_turn_failures",
            "journey": "leo_turn"
          }
        },
        {
          "record": "slo:leo_turn_overhead:bad_ratio:rate5m",
          "expr": "1 - sum(rate(shosai_agent_platform_overhead_seconds_bucket{home=\"eu\",le=\"0.5\"}[5m])) / sum(rate(shosai_agent_platform_overhead_seconds_count{home=\"eu\"}[5m]))",
          "labels": {
            "slo": "leo_turn_overhead",
            "journey": "leo_turn"
          }
        },
        {
          "record": "slo:leo_turn_overhead:bad_ratio:rate30m",
          "expr": "1 - sum(rate(shosai_agent_platform_overhead_seconds_bucket{home=\"eu\",le=\"0.5\"}[30m])) / sum(rate(shosai_agent_platform_overhead_seconds_count{home=\"eu\"}[30m]))",
          "labels": {
            "slo": "leo_turn_overhead",
            "journey": "leo_turn"
          }
        },
        {
          "record": "slo:leo_turn_overhead:bad_ratio:rate1h",
          "expr": "1 - sum(rate(shosai_agent_platform_overhead_seconds_bucket{home=\"eu\",le=\"0.5\"}[1h])) / sum(rate(shosai_agent_platform_overhead_seconds_count{home=\"eu\"}[1h]))",
          "labels": {
            "slo": "leo_turn_overhead",
            "journey": "leo_turn"
          }
        },
        {
          "record": "slo:leo_turn_overhead:bad_ratio:rate6h",
          "expr": "1 - sum(rate(shosai_agent_platform_overhead_seconds_bucket{home=\"eu\",le=\"0.5\"}[6h])) / sum(rate(shosai_agent_platform_overhead_seconds_count{home=\"eu\"}[6h]))",
          "labels": {
            "slo": "leo_turn_overhead",
            "journey": "leo_turn"
          }
        },
        {
          "record": "slo:leo_turn_overhead:bad_ratio:rate3d",
          "expr": "1 - sum(rate(shosai_agent_platform_overhead_seconds_bucket{home=\"eu\",le=\"0.5\"}[3d])) / sum(rate(shosai_agent_platform_overhead_seconds_count{home=\"eu\"}[3d]))",
          "labels": {
            "slo": "leo_turn_overhead",
            "journey": "leo_turn"
          }
        }
      ]
    }
  ]
}
