{
  "rule_files": [
    "connectors.alerts.json"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "interval": "1m",
      "input_series": [
        {
          "series": "shosai_connectors_undecryptable_secrets",
          "values": "0x10 1x10 0x40"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "15m",
          "alertname": "ConnectorSecretUndecryptable",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "invariant": "ADR 0075"
              },
              "exp_annotations": {
                "summary": "Секрет подключения не расшифровывается",
                "description": "Еженедельная проверка нашла токены или пароли подключённых сервисов, которые не открывает ни один ключ кольца Fernet. Эти подключения больше не работают, а человек об этом не знает. Обычно это значит, что ключ убрали из FERNET_KEYS_PREVIOUS раньше, чем закончилась ротация.",
                "runbook": "docs/runbooks/alerts.md#connector-secret-undecryptable",
                "dashboard": "/d/invariant-monitors"
              }
            }
          ]
        },
        {
          "eval_time": "45m",
          "alertname": "ConnectorSecretUndecryptable",
          "exp_alerts": []
        }
      ]
    },
    {
      "interval": "1m",
      "input_series": [
        {
          "series": "shosai_connectors_refresh_lost_total",
          "values": "0x10 1x50"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "15m",
          "alertname": "ConnectorRefreshLost",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "invariant": "ADR 0075"
              },
              "exp_annotations": {
                "summary": "Новый токен подключения потерян",
                "description": "Провайдер выдал новый refresh-токен, а записать его в базу не удалось. У таких провайдеров старый токен уже не работает, поэтому подключение сломается при следующем вызове, и человеку придётся подключить сервис заново.",
                "runbook": "docs/runbooks/alerts.md#connector-refresh-lost",
                "dashboard": "/d/invariant-monitors"
              }
            }
          ]
        },
        {
          "eval_time": "45m",
          "alertname": "ConnectorRefreshLost",
          "exp_alerts": []
        }
      ]
    },
    {
      "interval": "1m",
      "input_series": [
        {
          "series": "shosai_connectors_client_misconfigured_total",
          "values": "0x10 1x50"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "15m",
          "alertname": "ConnectorClientMisconfigured",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "invariant": "ADR 0075"
              },
              "exp_annotations": {
                "summary": "Провайдер отверг приложение Shosai",
                "description": "Провайдер ответил, что не знает приложение OAuth Shosai или его секрет. Каждое подключение к этому провайдеру перестанет работать при следующем обновлении токена. Чаще всего истёк секрет приложения, например в Microsoft Entra.",
                "runbook": "docs/runbooks/alerts.md#connector-client-misconfigured",
                "dashboard": "/d/invariant-monitors"
              }
            }
          ]
        },
        {
          "eval_time": "45m",
          "alertname": "ConnectorClientMisconfigured",
          "exp_alerts": []
        }
      ]
    },
    {
      "interval": "1m",
      "input_series": [
        {
          "series": "shosai_connectors_provider_quota_near_total",
          "values": "0x10 1x50"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "15m",
          "alertname": "ConnectorQuotaNear",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "invariant": "ADR 0075"
              },
              "exp_annotations": {
                "summary": "Квота приложения у провайдера почти исчерпана",
                "description": "Провайдер ответил, что приложение Shosai израсходовало больше 80% своей квоты: у Atlassian это 65 000 очков в час на всех клиентов сразу. Когда квота кончится, провайдер начнёт отказывать всем подключениям, а не одному человеку.",
                "runbook": "docs/runbooks/alerts.md#connector-quota-near",
                "dashboard": "/d/invariant-monitors"
              }
            }
          ]
        },
        {
          "eval_time": "45m",
          "alertname": "ConnectorQuotaNear",
          "exp_alerts": []
        }
      ]
    }
  ]
}
