          "series": "shosai_task_unknown_total",
          "values": "0x10 1x50"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "15m",
          "alertname": "UnknownTaskDropped",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "invariant": "§14 rule 9"
              },
              "exp_annotations": {
                "summary": "Фоновая работа потерялась: сервер получил задачу, которую не умеет выполнять",
                "description": "Сервер выбросил фоновую задачу, потому что ни один обработчик её не знает. Обычно так бывает, когда новая версия выложена в неправильном порядке. Работа этой задачи — письмо, обработка, синхронизация — не выполнена.",
                "runbook": "docs/runbooks/alerts.md#unknown-task-dropped",
                "dashboard": "/d/invariant-monitors"
              }
            }
          ]
        },
        {
          "eval_time": "45m",
          "alertname": "UnknownTaskDropped",
          "exp_alerts": []
        }
      ]
    },
