{
  "rule_files": [
    "files.alerts.json"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "interval": "1m",
      "input_series": [
        {
          "series": "shosai_files_quota_drift",
          "values": "0x10 1x10 0x40"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "15m",
          "alertname": "StorageCounterDrift",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "invariant": "inv-11"
              },
              "exp_annotations": {
                "summary": "Счётчик занятого места расходится с файлами",
                "description": "Ежедневная сверка нашла людей, у которых учтённое место не равно сумме их файлов. Квота считает неверно: человеку могут отказать в загрузке зря или пустить сверх тарифа. Id людей — в журнале сверки; счётчик правят только после разбора причины.",
                "runbook": "docs/runbooks/alerts.md#storage-counter-drift",
                "dashboard": "/d/invariant-monitors"
              }
            }
          ]
        },
        {
          "eval_time": "45m",
          "alertname": "StorageCounterDrift",
          "exp_alerts": []
        }
      ]
    },
    {
      "interval": "1m",
      "input_series": [
        {
          "series": "shosai_files_orphaned_objects",
          "values": "0x10 1x10 0x40"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "15m",
          "alertname": "OrphanedObject",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "invariant": "inv-11"
              },
              "exp_annotations": {
                "summary": "В бакете есть файлы, на которые не указывает ни одна строка",
                "description": "Сверка нашла в бакете дома объекты старше суток без строки файла и без ожидающего удаления. Это байты, которые никто не видит и за которые платит сервис; они могли остаться после сбоя удаления. Нужно найти причину, прежде чем удалять объекты.",
                "runbook": "docs/runbooks/alerts.md#orphaned-object",
                "dashboard": "/d/invariant-monitors"
              }
            }
          ]
        },
        {
          "eval_time": "45m",
          "alertname": "OrphanedObject",
          "exp_alerts": []
        }
      ]
    }
  ]
}
