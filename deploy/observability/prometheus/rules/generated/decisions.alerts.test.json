        {
          "eval_time": "15m",
          "alertname": "DecisionUnsafeOutcome",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "invariant": "ADR 0069"
              },
              "exp_annotations": {
                "summary": "Политика решений Leo предложила исход мягче правила",
                "description": "Политика решений ответила менее осторожно, чем жёсткое правило: например, обычная карточка вместо предупреждения. Слой решений отбросил этот ответ и оставил исход правила, так что человек защищён, но версия политики сломана — её надо снять, пока она в силе.",
                "runbook": "docs/runbooks/alerts.md#decision-unsafe-outcome",
                "dashboard": "/d/invariant-monitors"
              }
            }
          ]
        },
