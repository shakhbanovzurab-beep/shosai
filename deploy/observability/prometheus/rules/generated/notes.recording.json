{
  "groups": [
    {
      "name": "notes-slo-recording",
      "rules": [
        {
          "record": "slo:post_meeting_failures:bad_ratio:rate5m",
          "expr": "(sum(rate(shosai_notes_runs_total{outcome=\"failed\"}[5m])) or vector(0)) / sum(rate(shosai_notes_runs_total[5m]))",
          "labels": {
            "slo": "post_meeting_failures",
            "journey": "post_meeting"
          }
        },
        {
          "record": "slo:post_meeting_failures:bad_ratio:rate30m",
          "expr": "(sum(rate(shosai_notes_runs_total{outcome=\"failed\"}[30m])) or vector(0)) / sum(rate(shosai_notes_runs_total[30m]))",
          "labels": {
            "slo": "post_meeting_failures",
            "journey": "post_meeting"
          }
        },
        {
          "record": "slo:post_meeting_failures:bad_ratio:rate1h",
          "expr": "(sum(rate(shosai_notes_runs_total{outcome=\"failed\"}[1h])) or vector(0)) / sum(rate(shosai_notes_runs_total[1h]))",
          "labels": {
            "slo": "post_meeting_failures",
            "journey": "post_meeting"
          }
        },
        {
          "record": "slo:post_meeting_failures:bad_ratio:rate6h",
          "expr": "(sum(rate(shosai_notes_runs_total{outcome=\"failed\"}[6h])) or vector(0)) / sum(rate(shosai_notes_runs_total[6h]))",
          "labels": {
            "slo": "post_meeting_failures",
            "journey": "post_meeting"
          }
        },
        {
          "record": "slo:post_meeting_failures:bad_ratio:rate3d",
          "expr": "(sum(rate(shosai_notes_runs_total{outcome=\"failed\"}[3d])) or vector(0)) / sum(rate(shosai_notes_runs_total[3d]))",
          "labels": {
            "slo": "post_meeting_failures",
            "journey": "post_meeting"
          }
        },
        {
          "record": "slo:post_meeting_latency:bad_ratio:rate5m",
          "expr": "1 - sum(rate(shosai_notes_notes_ready_seconds_bucket{source=~\".+\",le=\"600\"}[5m])) / sum(rate(shosai_notes_notes_ready_seconds_count{source=~\".+\"}[5m]))",
          "labels": {
            "slo": "post_meeting_latency",
            "journey": "post_meeting"
          }
        },
        {
          "record": "slo:post_meeting_latency:bad_ratio:rate30m",
          "expr": "1 - sum(rate(shosai_notes_notes_ready_seconds_bucket{source=~\".+\",le=\"600\"}[30m])) / sum(rate(shosai_notes_notes_ready_seconds_count{source=~\".+\"}[30m]))",
          "labels": {
            "slo": "post_meeting_latency",
            "journey": "post_meeting"
          }
        },
        {
          "record": "slo:post_meeting_latency:bad_ratio:rate1h",
          "expr": "1 - sum(rate(shosai_notes_notes_ready_seconds_bucket{source=~\".+\",le=\"600\"}[1h])) / sum(rate(shosai_notes_notes_ready_seconds_count{source=~\".+\"}[1h]))",
          "labels": {
            "slo": "post_meeting_latency",
            "journey": "post_meeting"
          }
        },
        {
          "record": "slo:post_meeting_latency:bad_ratio:rate6h",
          "expr": "1 - sum(rate(shosai_notes_notes_ready_seconds_bucket{source=~\".+\",le=\"600\"}[6h])) / sum(rate(shosai_notes_notes_ready_seconds_count{source=~\".+\"}[6h]))",
          "labels": {
            "slo": "post_meeting_latency",
            "journey": "post_meeting"
          }
        },
        {
          "record": "slo:post_meeting_latency:bad_ratio:rate3d",
          "expr": "1 - sum(rate(shosai_notes_notes_ready_seconds_bucket{source=~\".+\",le=\"600\"}[3d])) / sum(rate(shosai_notes_notes_ready_seconds_count{source=~\".+\"}[3d]))",
          "labels": {
            "slo": "post_meeting_latency",
            "journey": "post_meeting"
          }
        }
      ]
    }
  ]
}
