          "series": "slo:sign_in_availability:bad_ratio:rate3d{slo=\"sign_in_availability\",journey=\"sign_in\"}",
          "values": "0x10 1x80 0x60"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "80m",
          "alertname": "SignInAvailabilityBudgetBurnFast",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "slo": "sign_in_availability",
                "journey": "sign_in"
              },
              "exp_annotations": {
                "summary": "Люди не могут войти в аккаунт: вход заканчивается ошибкой",
                "description": "Мы обещаем, что вход в аккаунт срабатывает без ошибки с нашей стороны в 99,9 % случаев. Сбоев сейчас очень много: если так продолжится, обещание на этот месяц будет нарушено примерно через 2 дня.",
                "runbook": "docs/runbooks/alerts.md#slo-budget-burn",
                "dashboard": "/d/journey-sign-in"
              }
            }
          ]
        },
        {
          "eval_time": "80m",
          "alertname": "SignInAvailabilityBudgetBurnSlow",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "page",
                "slo": "sign_in_availability",
                "journey": "sign_in"
