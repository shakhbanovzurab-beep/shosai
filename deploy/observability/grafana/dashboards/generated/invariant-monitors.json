      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "title": "Фоновая работа потерялась: сервер получил задачу, которую не умеет выполнять",
      "description": "Сервер выбросил фоновую задачу, потому что ни один обработчик её не знает. Обычно так бывает, когда новая версия выложена в неправильном порядке. Работа этой задачи — письмо, обработка, синхронизация — не выполнена.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(shosai_task_unknown_total[15m])) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "нет данных",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": -1000000000000000.0
              },
              {
                "color": "#d03b3b",
                "value": 1e-09
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -1000000000000000.0,
                "to": 0,
                "result": {
                  "text": "нет ✓"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1e-09,
                "to": 1000000000000000.0,
                "result": {
                  "text": "да ✗"
                }
              }
            }
          ]
