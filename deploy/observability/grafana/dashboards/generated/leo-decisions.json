          "expr": "sum(rate(shosai_decision_requests_total{point=\"turn.route\",source=\"jev\"}[1h])) / sum(rate(shosai_decision_requests_total{point=\"turn.route\",reason!~\"nothing_to_decide|policy_off\"}[1h]))",
