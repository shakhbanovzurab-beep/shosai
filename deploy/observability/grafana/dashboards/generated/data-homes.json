      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(probe_duration_seconds{probe=\"home_database\",home=\"ru\"}) * 1000",
          "legendFormat": "Россия",
          "range": true,
          "exemplar": false
