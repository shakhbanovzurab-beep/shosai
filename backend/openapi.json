{
  "openapi": "3.1.0",
  "info": {
    "title": "Shosai API",
    "version": "2.0.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Connectivity probe",
        "description": "Answer 200 while the process serves HTTP; dependencies are not checked.",
        "operationId": "health_check_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/unsubscribe": {
      "get": {
        "tags": [
          "email"
        ],
        "summary": "Unsubscribe Page",
        "description": "Ask before unsubscribing; after the form, say it is done.",
        "operationId": "unsubscribe_page_v1_unsubscribe_get",
        "parameters": [
          {
            "name": "t",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512,
              "default": "",
              "title": "T"
            }
          },
          {
            "name": "done",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Done"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ],
              "title": "Accept-Language"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "email"
        ],
        "summary": "Unsubscribe",
        "description": "Unsubscribe the person the token names from its kind of mail.",
        "operationId": "unsubscribe_v1_unsubscribe_post",
        "parameters": [
          {
            "name": "t",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512,
              "default": "",
              "title": "T"
            }
          },
          {
            "name": "accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1024,
              "default": "",
              "title": "Accept"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsubscribeAnswer"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "303": {
            "description": "A browser goes to the done page."
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "List-Unsubscribe": {
                    "type": "string",
                    "enum": [
                      "One-Click"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Mail a 6-digit code to the address; the answer is the same for a taken address.",
        "operationId": "register_v1_auth_register_post",
        "parameters": [
          {
            "name": "user-agent",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "User-Agent"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationStartedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Verify",
        "description": "Create the account when the code is right; five wrong codes end the registration.",
        "operationId": "verify_v1_auth_register_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountCreatedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register/resend": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Resend",
        "description": "Mail a new code: three at most, a minute apart; earlier codes stop working.",
        "operationId": "resend_v1_auth_register_resend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationStartedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountCreatedResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "AccountCreatedResponse",
        "description": "The account the confirmed registration created."
      },
      "Consents": {
        "properties": {
          "personal_data": {
            "type": "boolean",
            "title": "Personal Data"
          },
          "cross_border": {
            "type": "boolean",
            "title": "Cross Border",
            "default": false
          },
          "marketing": {
            "type": "boolean",
            "title": "Marketing",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "personal_data"
        ],
        "title": "Consents",
        "description": "The consents of the registration form; personal data is required."
      },
      "DetailValue": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "ErrorDescription": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "params": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ErrorParam"
            },
            "type": "object",
            "title": "Params"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/InvalidField"
            },
            "type": "array",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "code",
          "request_id"
        ],
        "title": "ErrorDescription",
        "description": "The machine-readable error: a stable code, the request id and optional context."
      },
      "ErrorParam": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDescription"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/DetailValue"
                },
                "type": "object"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "error",
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Body of every error response of the HTTP API.\n\n`error.code` is the stable code a client turns into text; `error.request_id` equals\nthe `X-Request-ID` header. `detail` is kept for shipped clients: the code by default,\nthe draft's shape on routes whose draft contract had another one."
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "description": "The process answers HTTP requests."
      },
      "InvalidField": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "type"
        ],
        "title": "InvalidField",
        "description": "Where a request failed validation and why; the submitted value is never echoed."
      },
      "RegistrationRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          },
          "full_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Full Name"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Country",
            "description": "ISO 3166-1 alpha-2."
          },
          "language": {
            "type": "string",
            "maxLength": 16,
            "minLength": 2,
            "title": "Language"
          },
          "consents": {
            "$ref": "#/components/schemas/Consents"
          },
          "captcha_token": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "Captcha Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password",
          "full_name",
          "country",
          "language",
          "consents"
        ],
        "title": "RegistrationRequest",
        "description": "A new account: the address, a password, the name and where the person lives."
      },
      "RegistrationStartedResponse": {
        "properties": {
          "registration_id": {
            "type": "string",
            "format": "uuid",
            "title": "Registration Id"
          },
          "resend_after_seconds": {
            "type": "integer",
            "title": "Resend After Seconds"
          }
        },
        "type": "object",
        "required": [
          "registration_id",
          "resend_after_seconds"
        ],
        "title": "RegistrationStartedResponse",
        "description": "The id to confirm the code with, and when another code may be asked for."
      },
      "ResendRequest": {
        "properties": {
          "registration_id": {
            "type": "string",
            "format": "uuid",
            "title": "Registration Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "registration_id"
        ],
        "title": "ResendRequest",
        "description": "The registration to mail a new code for."
      },
      "UnsubscribeAnswer": {
        "properties": {
          "unsubscribed": {
            "type": "boolean",
            "title": "Unsubscribed"
          }
        },
        "type": "object",
        "required": [
          "unsubscribed"
        ],
        "title": "UnsubscribeAnswer",
        "description": "The same answer for every token: nothing about the account behind it."
      },
      "VerifyRequest": {
        "properties": {
          "registration_id": {
            "type": "string",
            "format": "uuid",
            "title": "Registration Id"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "registration_id",
          "code"
        ],
        "title": "VerifyRequest",
        "description": "The code mailed to the address, with the id of the registration it belongs to."
      }
    }
  }
}
