{
  "openapi": "3.1.0",
  "info": {
    "title": "Shosai API",
    "version": "2.0.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Connectivity probe",
        "description": "Answer 200 while the process serves HTTP; dependencies are not checked.",
        "operationId": "health_check_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/unsubscribe": {
      "get": {
        "tags": [
          "email"
        ],
        "summary": "Unsubscribe Page",
        "description": "Ask before unsubscribing; after the form, say it is done.",
        "operationId": "unsubscribe_page_v1_unsubscribe_get",
        "parameters": [
          {
            "name": "t",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512,
              "default": "",
              "title": "T"
            }
          },
          {
            "name": "done",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Done"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ],
              "title": "Accept-Language"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "email"
        ],
        "summary": "Unsubscribe",
        "description": "Unsubscribe the person the token names from its kind of mail.",
        "operationId": "unsubscribe_v1_unsubscribe_post",
        "parameters": [
          {
            "name": "t",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512,
              "default": "",
              "title": "T"
            }
          },
          {
            "name": "accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1024,
              "default": "",
              "title": "Accept"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsubscribeAnswer"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "303": {
            "description": "A browser goes to the done page."
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "List-Unsubscribe": {
                    "type": "string",
                    "enum": [
                      "One-Click"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Mail a 6-digit code to the address; the answer is the same for a taken address.",
        "operationId": "register_v1_auth_register_post",
        "parameters": [
          {
            "name": "user-agent",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "User-Agent"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationStartedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Verify",
        "description": "Create the account and sign it in when the code is right; five wrong codes end\nthe registration.",
        "operationId": "verify_v1_auth_register_verify_post",
        "parameters": [
          {
            "name": "user-agent",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "User-Agent"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountCreatedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register/resend": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Resend",
        "description": "Mail a new code: three at most, a minute apart; earlier codes stop working.",
        "operationId": "resend_v1_auth_register_resend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationStartedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Sign in with the address and password; set the refresh and CSRF cookies.",
        "operationId": "login_v1_auth_login_post",
        "parameters": [
          {
            "name": "user-agent",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "User-Agent"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh",
        "description": "Rotate the session of the refresh cookie; the CSRF header repeats its cookie.",
        "operationId": "refresh_v1_auth_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "End the session of the cookie, or of a refresh token in the body; always ok.",
        "operationId": "logout_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/LogoutRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object",
                  "title": "Response Logout V1 Auth Logout Post"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Read Me",
        "description": "The signed-in person with their plan, minutes and switches.",
        "operationId": "read_me_v1_auth_me_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error. The body is the error envelope; see `ErrorResponse`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountCreatedResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "access_token",
          "expires_in",
          "csrf_token"
        ],
        "title": "AccountCreatedResponse",
        "description": "The account the confirmed registration created, signed in as at sign-in."
      },
      "Consents": {
        "properties": {
          "personal_data": {
            "type": "boolean",
            "title": "Personal Data"
          },
          "cross_border": {
            "type": "boolean",
            "title": "Cross Border",
            "default": false
          },
          "marketing": {
            "type": "boolean",
            "title": "Marketing",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "personal_data"
        ],
        "title": "Consents",
        "description": "The consents of the registration form; personal data is required."
      },
      "DetailValue": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "ErrorDescription": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "params": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ErrorParam"
            },
            "type": "object",
            "title": "Params"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/InvalidField"
            },
            "type": "array",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "code",
          "request_id"
        ],
        "title": "ErrorDescription",
        "description": "The machine-readable error: a stable code, the request id and optional context."
      },
      "ErrorParam": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDescription"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/DetailValue"
                },
                "type": "object"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "error",
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Body of every error response of the HTTP API.\n\n`error.code` is the stable code a client turns into text; `error.request_id` equals\nthe `X-Request-ID` header. `detail` is kept for shipped clients: the code by default,\nthe draft's shape on routes whose draft contract had another one."
      },
      "FeaturesOut": {
        "properties": {
          "voice_translation": {
            "type": "boolean",
            "title": "Voice Translation",
            "default": false
          },
          "voice": {
            "type": "boolean",
            "title": "Voice",
            "default": false
          },
          "teleprompter": {
            "type": "boolean",
            "title": "Teleprompter",
            "default": false
          },
          "premium_weekly_remaining_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Premium Weekly Remaining Pct"
          },
          "premium_credit_usd": {
            "type": "number",
            "title": "Premium Credit Usd",
            "default": 0.0
          },
          "premium_credit_currency": {
            "type": "string",
            "title": "Premium Credit Currency",
            "default": "USD"
          },
          "premium_credit_amount": {
            "type": "number",
            "title": "Premium Credit Amount",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "FeaturesOut",
        "description": "Capabilities of the plan; the draft's defaults until billing contributes."
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "description": "The process answers HTTP requests."
      },
      "InvalidField": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "type"
        ],
        "title": "InvalidField",
        "description": "Where a request failed validation and why; the submitted value is never echoed."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          },
          "captcha_token": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "Captcha Token"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "Address and password; the captcha token when the sign-in page shows one."
      },
      "LogoutRequest": {
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "title": "LogoutRequest",
        "description": "The refresh token of a client that keeps it outside the cookie jar (optional)."
      },
      "QuotaSnapshot": {
        "properties": {
          "unlimited": {
            "type": "boolean",
            "title": "Unlimited"
          },
          "limit_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit Minutes"
          },
          "bonus_minutes": {
            "type": "integer",
            "title": "Bonus Minutes"
          },
          "used_minutes": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Used Minutes"
          },
          "remaining_minutes": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining Minutes"
          },
          "exhausted": {
            "type": "boolean",
            "title": "Exhausted"
          }
        },
        "type": "object",
        "required": [
          "unlimited",
          "limit_minutes",
          "bonus_minutes",
          "used_minutes",
          "remaining_minutes",
          "exhausted"
        ],
        "title": "QuotaSnapshot",
        "description": "Recording minutes left; billing fills it."
      },
      "RegistrationRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          },
          "full_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Full Name"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Country",
            "description": "ISO 3166-1 alpha-2."
          },
          "language": {
            "type": "string",
            "maxLength": 16,
            "minLength": 2,
            "title": "Language"
          },
          "consents": {
            "$ref": "#/components/schemas/Consents"
          },
          "captcha_token": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "Captcha Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password",
          "full_name",
          "country",
          "language",
          "consents"
        ],
        "title": "RegistrationRequest",
        "description": "A new account: the address, a password, the name and where the person lives."
      },
      "RegistrationStartedResponse": {
        "properties": {
          "registration_id": {
            "type": "string",
            "format": "uuid",
            "title": "Registration Id"
          },
          "resend_after_seconds": {
            "type": "integer",
            "title": "Resend After Seconds"
          }
        },
        "type": "object",
        "required": [
          "registration_id",
          "resend_after_seconds"
        ],
        "title": "RegistrationStartedResponse",
        "description": "The id to confirm the code with, and when another code may be asked for."
      },
      "ResendRequest": {
        "properties": {
          "registration_id": {
            "type": "string",
            "format": "uuid",
            "title": "Registration Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "registration_id"
        ],
        "title": "ResendRequest",
        "description": "The registration to mail a new code for."
      },
      "SubscriptionCardDTO": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "tariff": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TariffDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "days_left": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days Left"
          },
          "bonus_minutes": {
            "type": "integer",
            "title": "Bonus Minutes"
          },
          "credits": {
            "type": "number",
            "title": "Credits"
          }
        },
        "type": "object",
