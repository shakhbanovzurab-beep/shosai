<!doctype html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="robots" content="noindex, nofollow">
<title>{{ title }} · Shosai</title>
<style>
  :root { --paper:#FAFAFA; --card:#FFFFFF; --ink:#0A0A0A; --muted:#737373; --border:#E5E5E5; --button:#171717; --button-ink:#FAFAFA; }
  @media (prefers-color-scheme: dark) {
    :root { --paper:#0A0A0A; --card:#171717; --ink:#FAFAFA; --muted:#A3A3A3; --border:#262626; --button:#E5E5E5; --button-ink:#0A0A0A; }
  }
  * { box-sizing:border-box; }
  body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px 16px; background:var(--paper); color:var(--ink); font-family:{{ font }}; }
  main { width:100%; max-width:480px; background:var(--card); border:1px solid var(--border); border-radius:14px; padding:32px; }
  .brand { display:flex; align-items:center; gap:12px; margin:0 0 28px; font-size:20px; font-weight:600; letter-spacing:-0.01em; }
  .brand img { width:36px; height:36px; border-radius:8px; }
  h1 { margin:0 0 12px; font-size:22px; line-height:1.3; font-weight:600; letter-spacing:-0.02em; }
  p { margin:0 0 24px; font-size:15px; line-height:1.6; color:var(--muted); }
  button { appearance:none; border:0; border-radius:10px; padding:12px 22px; font:inherit; font-size:15px; font-weight:500; background:var(--button); color:var(--button-ink); cursor:pointer; }
  button:focus-visible { outline:2px solid var(--ink); outline-offset:3px; }
</style>
</head>
<body>
<main>
  <div class="brand"><img src="/email/shosai-icon.png" alt="">Shosai</div>
  <h1>{{ title }}</h1>
  <p>{{ lead }}</p>
  {%- if not done %}
  <form method="post">
    <input type="hidden" name="token" value="{{ token }}">
    <button type="submit">{{ button }}</button>
  </form>
  {%- endif %}
</main>
</body>
</html>
